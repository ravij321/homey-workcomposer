<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.homey.workinsights.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/HomeyWorkInsights/HomeyAgent</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Library/Logs/HomeyWorkInsights/agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/HomeyWorkInsights/agent.error.log</string>
</dict>
</plist>
